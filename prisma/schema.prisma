// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  role      String
  color     String
  createdAt DateTime @default(now())

  projects       ProjectMember[]
  tasks          Task[]
  comments       Comment[]
  taskEvents     TaskEvent[]
}

model Project {
  id          String   @id
  name        String
  description String?
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime?

  members    ProjectMember[]
  tasks      Task[]
  taskEvents TaskEvent[]
}

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id          String    @id
  key         String    @unique
  projectId   String
  title       String
  description String?
  assigneeId  String
  priority    String
  status      String
  dueDate     String
  createdAt   DateTime  @default(now())
  movedAt     DateTime  @default(now())
  completedAt DateTime?

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User        @relation(fields: [assigneeId], references: [id])
  comments Comment[]
  events   TaskEvent[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model Comment {
  id        String   @id
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskEvent {
  id         String   @id
  taskId     String
  projectId  String
  userId     String
  fromStatus String?
  toStatus   String
  createdAt  DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([taskId])
}
