// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  password      String?
  role          String
  color         String
  createdAt     DateTime     @default(now())

  // Telegram notification fields
  telegramChatId              String?   @unique
  telegramLinkToken           String?
  telegramLinkTokenExpiresAt  DateTime?

  projects         ProjectMember[]
  tasks            Task[]
  comments         Comment[]
  taskEvents       TaskEvent[]
  commitLinks      CommitLink[]
}

model Project {
  id          String   @id
  name        String
  description String?
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime?

  members    ProjectMember[]
  tasks      Task[]
  taskEvents TaskEvent[]
}

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      String @default("member")
  designation String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id            String       @id
  key           String       @unique
  projectId     String
  title         String
  description   String?
  assigneeId    String
  priority      String
  status        String
  dueDate       String
  createdAt     DateTime     @default(now())
  movedAt       DateTime     @default(now())
  completedAt   DateTime?

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User           @relation(fields: [assigneeId], references: [id])
  comments      Comment[]
  events        TaskEvent[]
  commitLinks   CommitLink[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model Comment {
  id        String   @id
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TaskEvent {
  id         String   @id
  taskId     String
  projectId  String
  userId     String
  fromStatus String?
  toStatus   String
  createdAt  DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@index([taskId])
}

model CommitLink {
  id            String   @id @default(uuid())
  taskId        String
  commitSha     String   @db.VarChar(64)
  commitMessage String   @db.Text
  authorName    String
  authorEmail   String?
  authorUserId  String?
  githubUsername String?
  branch        String?
  commitUrl     String   @db.VarChar(512)
  committedAt   DateTime
  createdAt     DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUser  User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, commitSha])
  @@index([taskId])
}
