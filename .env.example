# Hostlink Environment Variables
# Copy this file to .env and fill in your actual values

# Database Connection
# For local SQLite (development):
# DATABASE_URL="file:./dev.db"
#
# For Aiven MySQL (production):
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require&sslcacert=ca.pem"

# Example for Aiven MySQL:
# DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD_HERE@mysql-mydatabases-xxxxx.h.aivencloud.com:28768/tracker_db?sslmode=require&sslcacert=ca.pem"
